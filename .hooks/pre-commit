#!/usr/bin/env bash
# Every gate before every commit (git config core.hooksPath .hooks). Skip once with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -d node_modules ] || { echo "pre-commit: no node_modules here, gates skipped (npm run check runs them)"; exit 0; }
NODE_OPTIONS=--max-old-space-size=1024 npm run -s gates
