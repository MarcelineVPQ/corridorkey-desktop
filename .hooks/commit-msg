#!/usr/bin/env bash
# The docs-touch gate on the commit being made (senior review 2026-10-27 S6): its staged files and this message.
# A CLI change (args.rs, cliSpec.json) needs docs/CLI.md, docs/wiki/Command-Line.md and docs/GUIDE.md staged, or a
# line `docs: none-needed — why` in the message. Needs node only, no node_modules. Skip once with --no-verify.
set -euo pipefail
# native Windows: skipped like the pre-commit gates (which print the WSL note; release review 2026-10-28 #10)
case "$(uname -s)" in MINGW* | MSYS* | CYGWIN*) exit 0 ;; esac
msg="$(realpath "$1")"
cd "$(git rev-parse --show-toplevel)"
# an amend replaces HEAD, so the commit's files are the index against HEAD^ (release review 2026-10-28 #12). git doesn't
# tell this hook; its parent, `git commit`, has --amend among its arguments, directly or through an alias (`git ca`
# with alias.ca = commit --amend keeps "git ca" as its arguments: release re-review 2026-10-28 #5), so the first words
# that name an alias are replaced by it
amend=""
parent="$(ps -o args= -p "$PPID" 2>/dev/null || true)"
read -ra words <<<"$parent"
# loop: NOT-WORTH — the command's first 8 words, one git config read each
for w in "${words[@]:0:8}"; do
  case "$w" in -* | */* | *=*) continue ;; esac
  parent="$parent $(git config --get "alias.$w" 2>/dev/null || true)"
done
grep -qE -- '(^| )--amend( |$)' <<<"$parent" && amend=--amend
# shellcheck disable=SC2086 # amend is empty or one word
exec node tools/check_docs_touch.mjs --staged "$msg" $amend
