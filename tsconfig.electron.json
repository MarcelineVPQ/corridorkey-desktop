{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["electron", "src/shared", "src/ui/theme/palette.ts", "src/ui/rail/railModel.ts", "src/ui/paths.ts", "src/ui/format.ts", "src/ui/console/editor.ts", "src/ui/console/model.ts", "tests"]
}
